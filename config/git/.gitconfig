[user]
    # Preencha com seu nome e e-mail do GitHub
    # name = Seu Nome
    # email = seu-email@example.com
    # signingkey = ~/.ssh/id_ed25519.pub

[commit]
    gpgsign = true

[gpg]
    format = ssh

[core]
    autocrlf = input

[alias]
    lg = log --oneline --graph --decorate
    co = checkout
    br = branch

[pull]
    rebase = false