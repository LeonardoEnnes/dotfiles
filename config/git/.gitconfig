[user]
    name = ${GIT_USER_NAME}
    email = ${GIT_USER_EMAIL}
    signingkey = /home/${USER}/.ssh/id_ed25519.pub

[commit]
	gpgsign = true

[gpg]
	format = ssh

[core]
    autocrlf = input

[alias]
    lg = log --oneline --graph --decorate
    co = checkout
    br = branch

[pull]
    rebase = false